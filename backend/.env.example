# QuickBite Agentic Analytics - environment template
#
# Copy this file to `backend/.env` and fill in the values you need:
#     cp .env.example .env
#
# IMPORTANT: `.env` is git-ignored (see the repository .gitignore) and must
# never be committed. This `.env.example` file contains no secrets and IS
# committed, so keep real keys out of it.
#
# Every variable below is optional. Anything left blank falls back to the
# default defined in backend/app/config.py.


# --- LLM provider API keys -------------------------------------------------
# All four are optional. The system tries providers in the order defined by
# LLM_PROVIDER_ORDER (anthropic, openai, gemini, grok) and uses the first one
# with a non-empty key. Leaving all of them blank is valid; the app still
# starts and /health reports an empty `providers_configured` list.

# Anthropic (Claude) - preferred provider. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT) - first fallback. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini) - second fallback. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# xAI (Grok) - final fallback. https://console.x.ai/
GROK_API_KEY=


# --- Application settings --------------------------------------------------

# Deployment environment name, surfaced on /health. Use `development` locally
# and `production` when deployed.
ENVIRONMENT=development

# Browser origins allowed to call the API, as a JSON array. The Next.js dev
# server runs on port 3000; add your deployed frontend URL in production.
# Example: ["http://localhost:3000","https://quickbite.example.com"]
CORS_ORIGINS=["http://localhost:3000"]
