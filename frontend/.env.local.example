# Frontend environment template.
#
# Copy to `.env.local` for local development:
#     cp .env.local.example .env.local
#
# `.env.local` is git-ignored. This example file is committed and holds no
# secrets: NEXT_PUBLIC_* variables are inlined into the browser bundle at build
# time and are therefore public by definition. Never put an API key here.

# Base URL of the QuickBite analytics API, with no trailing slash.
#
# Local development:
#     http://localhost:8000
#
# Production (set this in the Vercel dashboard, not in this file):
#     https://quickbite-analytics-api.onrender.com
#
# Changing this requires a rebuild, because Next.js inlines it at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
